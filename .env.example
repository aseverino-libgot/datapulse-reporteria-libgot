# Gemini AI - Solo servidor, NUNCA usar prefijo VITE_
GEMINI_API_KEY=your_gemini_api_key_here

# API externa de ventas
BI_API_KEY=your_bi_api_key_here

# ID del Google Sheet de permisos
PERMISSIONS_SPREADSHEET_ID=your_spreadsheet_id_here

# Cuenta de servicio Google (JSON completo en una sola línea)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Redshift (DWH) - Solo servidor
REDSHIFT_HOST=your_redshift_host_here
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=your_database_here
REDSHIFT_USER=your_readonly_user_here
REDSHIFT_PASSWORD=your_password_here
